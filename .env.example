# Potion Pantry - Environment Configuration Example
# Copy this file to .env and fill in your values

# Google OAuth 2.0 Web Client ID obtained from Google Cloud Console
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
GOOGLE_CLIENT_ID=985847650621-a83dhfihhfijl3j1bl0ssmu5k10srthb.apps.googleusercontent.com

# Cryptographic secret for signing session HMAC tokens
SESSION_SECRET=potion-pantry-spooky-secure-secret-2026

# Google Gemini API Key (Secret - never commit or send to frontend/clients)
GEMINI_API_KEY=your_gemini_api_key_here

# Copilot Model Identifier (from official Gemini model suite)
COPILOT_MODEL=gemini-2.5-flash

# Execution Guardrails
COPILOT_TIMEOUT_SECONDS=10
COPILOT_MAX_TOOL_STEPS=5
COPILOT_MAX_INPUT_CHARS=500
COPILOT_RATE_LIMIT_PER_MINUTE=20
